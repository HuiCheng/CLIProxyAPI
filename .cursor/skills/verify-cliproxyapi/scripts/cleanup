#!/usr/bin/env bash
# 拆除由 scripts/launch 启动的验证实例。
# 保留 VERIFY_EVIDENCE_DIR 下的证据。
set -euo pipefail

. "$(cd "$(dirname "$0")" && pwd)/common.sh"

if ! verify_load_meta 2>/dev/null; then
  # 尽力清理陈旧的活动运行指针。
  if [[ -f "$ACTIVE_RUN_FILE" ]]; then
    run_id="$(tr -d '[:space:]' <"$ACTIVE_RUN_FILE" || true)"
    if [[ -n "$run_id" ]]; then
      verify_paths_for_run "$run_id"
    fi
  else
    echo "无需清理（没有活动运行）。"
    exit 0
  fi
fi

kill_pid_file() {
  local file="$1"
  local label="$2"
  if [[ ! -f "$file" ]]; then
    echo "没有 $label 的 pid 文件"
    return 0
  fi
  local pid
  pid="$(tr -d '[:space:]' <"$file")"
  if [[ -z "$pid" ]]; then
    echo "$label 的 pid 文件为空"
    rm -f "$file"
    return 0
  fi
  if kill -0 "$pid" 2>/dev/null; then
    echo "正在停止 $label pid $pid"
    kill "$pid" 2>/dev/null || true
    for _ in $(seq 1 20); do
      if ! kill -0 "$pid" 2>/dev/null; then
        break
      fi
      sleep 0.1
    done
    if kill -0 "$pid" 2>/dev/null; then
      echo "正在强制结束 $label pid $pid"
      kill -9 "$pid" 2>/dev/null || true
    fi
  else
    echo "$label pid $pid 已停止"
  fi
  rm -f "$file"
}

kill_pid_file "${VERIFY_PID_FILE:-}" "服务"
kill_pid_file "${VERIFY_MOCK_PID_FILE:-}" "mock 上游"

# 只删除 run/实例目录。保留证据。
if [[ -n "${VERIFY_RUN_DIR:-}" && -d "${VERIFY_RUN_DIR}" ]]; then
  rm -rf "$VERIFY_RUN_DIR"
  echo "已删除实例目录 $VERIFY_RUN_DIR"
fi

if [[ -f "$ACTIVE_RUN_FILE" ]]; then
  active="$(tr -d '[:space:]' <"$ACTIVE_RUN_FILE" || true)"
  if [[ -z "${VERIFY_RUN_ID:-}" || "$active" == "$VERIFY_RUN_ID" ]]; then
    rm -f "$ACTIVE_RUN_FILE"
  fi
fi

echo "清理完成。"
echo "证据保留在: ${VERIFY_EVIDENCE_DIR:-unknown}"
if [[ -n "${VERIFY_EVIDENCE_DIR:-}" && -d "${VERIFY_EVIDENCE_DIR}" ]]; then
  find "$VERIFY_EVIDENCE_DIR" -type f | sort || true
fi
