#!/usr/bin/env bash
# 对活动验证实例做只读健康检查。
set -euo pipefail

. "$(cd "$(dirname "$0")" && pwd)/common.sh"

verify_require_cmd curl
verify_load_meta

fail=0
say() { printf '%s\n' "$*"; }
ok() { say "OK  $*"; }
bad() { say "BAD $*"; fail=1; }

if [[ ! -f "$VERIFY_PID_FILE" ]]; then
  bad "缺少服务 pid 文件 $VERIFY_PID_FILE"
else
  pid="$(cat "$VERIFY_PID_FILE")"
  if kill -0 "$pid" 2>/dev/null; then
    ok "服务 pid $pid 存活"
  else
    bad "服务 pid $pid 未在运行"
  fi
fi

if [[ ! -f "$VERIFY_MOCK_PID_FILE" ]]; then
  bad "缺少 mock pid 文件 $VERIFY_MOCK_PID_FILE"
else
  mpid="$(cat "$VERIFY_MOCK_PID_FILE")"
  if kill -0 "$mpid" 2>/dev/null; then
    ok "mock 上游 pid $mpid 存活"
  else
    bad "mock 上游 pid $mpid 未在运行"
  fi
fi

base="$(verify_base_url)"
hz="$(curl -sS -o /tmp/cliproxyapi-doctor-healthz.json -w '%{http_code}' "$base/healthz" || true)"
if [[ "$hz" == "200" ]] && grep -q '"status":"ok"' /tmp/cliproxyapi-doctor-healthz.json; then
  ok "GET /healthz -> 200 {\"status\":\"ok\"}"
else
  bad "GET /healthz 失败 (code=$hz body=$(cat /tmp/cliproxyapi-doctor-healthz.json 2>/dev/null || true))"
fi

root="$(curl -sS -o /tmp/cliproxyapi-doctor-root.json -w '%{http_code}' "$base/" || true)"
if [[ "$root" == "200" ]] && grep -q 'CLI Proxy API Server' /tmp/cliproxyapi-doctor-root.json; then
  ok "GET / -> 200 身份文案存在"
else
  bad "GET / 身份检查失败 (code=$root)"
fi

owner_ok=0
if command -v ss >/dev/null 2>&1; then
  if ss -ltnp 2>/dev/null | grep -E ":${VERIFY_PORT}\\b" | grep -q "pid=$(cat "$VERIFY_PID_FILE")"; then
    owner_ok=1
  fi
fi
if [[ "$owner_ok" -eq 1 ]]; then
  ok "端口 ${VERIFY_PORT} 由验证服务 pid 占用"
else
  ok "端口 ${VERIFY_PORT} 在验证 BASE_URL 上可应答（ss 归属检查已跳过或不确定）"
fi

models_code="$(curl -sS -o /tmp/cliproxyapi-doctor-models.json -w '%{http_code}' \
  -H "Authorization: Bearer ${VERIFY_API_KEY}" "$base/v1/models" || true)"
if [[ "$models_code" == "200" ]] && grep -q "\"id\":\"${VERIFY_MODEL_ALIAS}\"" /tmp/cliproxyapi-doctor-models.json; then
  ok "带验证 API key 的 GET /v1/models 列出 ${VERIFY_MODEL_ALIAS}"
else
  bad "GET /v1/models 异常 (code=$models_code body=$(cat /tmp/cliproxyapi-doctor-models.json 2>/dev/null || true))"
fi

mgmt_code="$(curl -sS -o /tmp/cliproxyapi-doctor-mgmt.json -w '%{http_code}' \
  -H "Authorization: Bearer ${VERIFY_MGMT_KEY}" "$base/v0/management/api-keys" || true)"
if [[ "$mgmt_code" == "200" ]] && grep -q "${VERIFY_API_KEY}" /tmp/cliproxyapi-doctor-mgmt.json; then
  ok "带管理密钥的 GET /v0/management/api-keys 成功"
else
  bad "管理 api-keys 检查失败 (code=$mgmt_code)"
fi

say "---"
say "RUN_ID=${VERIFY_RUN_ID}"
say "BASE_URL=${base}"
say "EVIDENCE_DIR=${VERIFY_EVIDENCE_DIR}"
say "LOG=${VERIFY_LOG}"

if [[ "$fail" -ne 0 ]]; then
  say "doctor: FAIL — 不要驱动此实例"
  exit 1
fi
say "doctor: PASS — 实例值得驱动"
exit 0
